IDD_OPEN_MODEL DIALOGEX 0, 0, 310, 160
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Load Whisper Model"
FONT 11, "Calibri", 400, 0, 0x0
BEGIN
    LTEXT           "Please provide a Whisper model in GGML binary format.",IDC_STATIC,7,8,203,8
    CONTROL         "Debug Console",IDC_CONSOLE,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,237,7,66,10
    CONTROL         "You can download these binary files from <a href=""https://huggingface.co/ggerganov/whisper.cpp/tree/main"">Hugging Face</a>, or <a href=""https://github.com/ggerganov/whisper.cpp/tree/master/models"">generate</a> from OpenAI¡¯s Python models.",IDC_HYPERLINKS,
                    "SysLink",WS_TABSTOP,7,22,296,22
    LTEXT           "Model Path",IDC_STATIC,7,45,39,8
    EDITTEXT        IDC_PATH,7,60,280,12,ES_AUTOHSCROLL
    PUSHBUTTON      "...",IDC_BROWSE,288,60,15,12
    LTEXT           "Engine:",IDC_STATIC,7,81,30,8
    COMBOBOX        IDC_MODEL_KIND,41,80,76,47,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Implementation:",IDC_MODEL_TYPE_LBL,122,81,62,8
    COMBOBOX        IDC_MODEL_TYPE,186,80,89,47,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Device:",IDC_SENSE_DEVICE_LBL,122,81,30,8,NOT WS_VISIBLE
    COMBOBOX        IDC_SENSE_DEVICE,154,80,85,100,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "",IDC_SENSE_DEVICE_TIP,7,95,256,18,NOT WS_VISIBLE
    PUSHBUTTON      "advanced¡­",IDC_MODEL_ADV,7,118,55,11
    LTEXT           "Loading model, please wait¡­",IDC_PENDING_TEXT,7,124,96,8,NOT WS_VISIBLE | WS_TABSTOP
    CONTROL         "",IDC_PROGRESS,"msctls_progress32",PBS_SMOOTH | NOT WS_VISIBLE | WS_BORDER,7,138,296,6
    DEFPUSHBUTTON   "OK",IDOK,199,139,50,14
    PUSHBUTTON      "Cancel",IDCANCEL,253,139,50,14
END

